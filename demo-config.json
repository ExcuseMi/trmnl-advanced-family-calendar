{
  "locale": "en",
  "timeZone": "America/New_York",
  "calendars": [
    {
      "id": "Family",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-family-calendar/main/demo/family.ics"
    },
    {
      "id": "Alex",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-family-calendar/main/demo/alex.ics",
      "defaultPerson": "Alex"
    },
    {
      "id": "Jordan",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-family-calendar/main/demo/jordan.ics",
      "defaultPerson": "Jordan"
    },
    {
      "id": "Mia",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-family-calendar/main/demo/mia.ics",
      "defaultPerson": "Mia"
    },
    {
      "id": "Leo",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-family-calendar/main/demo/leo.ics",
      "defaultPerson": "Leo"
    },
    {
      "id": "School",
      "url": "https://raw.githubusercontent.com/ExcuseMi/trmnl-family-calendar/main/demo/school.ics",
      "color": "gray-70",
      "exclude": "(?=.*\\b(?:L[1345]|K[123])\\b)(?!.*\\b(?:L2|L6)\\b)",
      "personRules": [
        { "match": "\\bL2\\b", "person": "Mia" },
        { "match": "\\bL6\\b", "person": "Leo" }
      ]
    },
    {
      "id": "Holidays",
      "url": "https://calendar.google.com/calendar/ical/en.usa%23holiday%40group.v.calendar.google.com/public/basic.ics",
      "color": "red"
    }
  ],
  "people": [
    { "name": "Alex", "color": "blue" },
    { "name": "Jordan", "color": "purple" },
    { "name": "Mia", "color": "pink" },
    { "name": "Leo", "color": "green" }
  ]
}
