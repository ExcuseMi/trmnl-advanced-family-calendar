

{% template badge_circle %}

  <span class="rounded--small {{head_badge_cls}} shrink-0 flex flex--center-x flex--center-y text--{{ fg }} bg--{{ hue }} " style="overflow:hidden;box-sizing:border-box;border:{{ border }}px solid currentColor;">
    {{- b.text -}}
  </span>
{% endtemplate %}

{% template chip_body %}

  <div class="w--full h--full flex flex--row flex--center-x flex--center-y w--min-0">
    <span class="title {{ title_cls }} text--{{ fg }} text--center cal-fit-text{% if clip %} cal-fit-clip{% endif %} {{ pad_right_cls }} w--min-0" data-fit-min="{{ fit_min }}" data-fit-max="90">{{ title }}</span>
  </div>
{% endtemplate %}

{% template chip %}

  <div class="{{ size_class }} bg--{{ hue }} text--{{ fg }} w--full {{ pad_cls }} {{ radius_cls }} flex {{ flex_dir }} flex--center-y cal-fit-box relative" style="overflow:hidden;box-sizing:border-box;{{ size_style }}border-top:2px solid currentColor;border-bottom:2px solid currentColor;{% if border_left %}border-left:2px solid currentColor;{% endif %}{% if border_right %}border-right:2px solid currentColor;{% endif %}">
    {%- render "chip_body", title: title, fg: fg, title_cls: title_cls, fit_min: fit_min, clip: clip, pad_right_cls: pad_right_cls -%}
  </div>
{% endtemplate %}

{% template main %}
<style>

.trmnl .screen--lg.screen--portrait .cal-head-badge { }
.hours { font-family:monospace; width:2ch; }
.cal-axis-period { color: #999; font-weight: normal; white-space: nowrap; }
</style>
{%- if view == 4 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
  {%- assign axis_cls = "label--small" -%}
  {%- assign event_pad_cls = "pt--0 pb--1" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_right_cls = "pr--1" -%}
  {%- assign head_badge_cls = "w--3 h--3"  -%}
{%- elsif view == 3 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
  {%- assign axis_cls = "label--base lg:label--large" -%}
  {%- assign event_pad_cls = "pt--0 pb--1" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_right_cls = "pr--1" -%}
  {%- assign head_badge_cls = "w--4 h--4" -%}
{%- elsif view == 2 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small lg:title--base" -%}
  {%- assign axis_cls = "label--base lg:label--large" -%}
  {%- assign event_pad_cls = "pt--1 pb--2" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_right_cls = "pr--2" -%}
  {%- assign head_badge_cls = "w--3 h--3" -%}
{%- else -%}

  {%- assign head_title_cls = "title--large lg:title--large lg:portrait:title--xlarge" -%}
  {%- assign chip_title_cls = "title--base lg:title--large lg:portrait:title--xlarge" -%}
  {%- assign axis_cls = "label--large lg:label--xxlarge" -%}
  {%- assign event_pad_cls = "pt--1 pb--2" -%}
  {%- assign event_title_cls = "title--base" -%}
  {%- assign pad_right_cls = "pr--2" -%}
  {%- assign head_badge_cls = "w--8 h--8" -%}
{%- endif -%}

{%- if view == 1 -%}
  {%- assign shown_days_n = days.size -%}
{%- else -%}
  {%- assign shown_days_n = 1 -%}
{%- endif -%}

{%- if shown_days_n >= 6 -%}
  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
{%- elsif shown_days_n >= 4 -%}
  {%- assign head_title_cls = "title--base lg:title--large" -%}
  {%- assign chip_title_cls = "title--small" -%}
{%- endif -%}

{%- if shown_days_n == 1 -%}
  {%- assign day_span = 12 -%}
{%- elsif shown_days_n == 2 -%}
  {%- assign day_span = 6 -%}
{%- else -%}
  {%- assign day_span = 4 -%}
{%- endif -%}

<div class="layout layout--col gap--none" id="cal-root">
  {% if error and has_events == false %}

    <div class="flex flex--col flex--center-x flex--center-y w--full h--full text--center p--6 gap--small" style="box-sizing:border-box;">
      <img src="https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/event_busy/default/48px.svg" alt="" class="h--auto w--max-8 lg:w--max-12">
      <span class="title title--large">{{ unavailable_label }}</span>
      <span class="description text--gray-50 w--max-[85%]" data-clamp="3">{{ error }}</span>
    </div>
  {% else %}

    <div class="grid gap--none h--[{{ header_pct }}cqh] h--min-[{{ header_pct }}cqh] bg--black flex-none" style="overflow:hidden;">

      <div class="flex flex--col flex--center-x flex--center-y p--0.5" style="overflow:hidden;box-sizing:border-box;">

        {%- if people.size > 0 and view == 1 -%}

          <div class="grid w--auto gap--none  grid--cols-2 ">
            {%- for b in people -%}
              {%- render "badge_circle", head_badge_cls:head_badge_cls, b: b, border: 1, hue: b.hue, fg: b.fg, extra: "cal-head-badge" -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {% for day in days limit: shown_days_n %}

        <div class="col--span-{{ day_span }} flex flex--col flex--center-x flex--center-y border--v-1">

          <div class="rounded--small px--2.5 py--0.5 w--max-full flex flex--col flex--center-x gap--[2px] w--min-0" style="overflow:hidden;">

            <span class="title {{ head_title_cls }} block w--min-0" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase;"><span class="text--gray-50">{{ day.label_short_weekday }}</span> <span class="text--white font--bold">{{ day.label_short_rest }}</span></span>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if allday_pct > 0 %}

      {%- assign allday_total_units = day_span | times: shown_days_n | plus: 1 -%}
      <div class="grid gap--none h--[{{ allday_pct }}cqh] h--min-[{{ allday_pct }}cqh] flex-none relative" style="grid-template-columns:repeat({{ allday_total_units }}, 1fr);overflow:hidden;">

        <div class="col--span-1 flex flex--col flex--center-x flex--center-y px--0.5" style="grid-row:1 / span {{ allday_max_rows }};overflow:hidden;box-sizing:border-box;">
          <img src="https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/today/default/48px.svg" alt="{{ all_day_label }}" class="md:w--8 lg:w--12">
        </div>
        {% for bar in allday_bars %}
          {% if bar.start_col < shown_days_n %}

          {% assign allday_visible_span = shown_days_n | minus: bar.start_col %}
          {% assign ad_continues_after = bar.continues_after %}
          {% if bar.span > allday_visible_span %}
            {% assign ad_continues_after = true %}
          {% else %}
            {% assign allday_visible_span = bar.span %}
          {% endif %}

          {% if bar.continues_before and ad_continues_after %}
            {% assign ad_radius_cls = "rounded--none" %}
          {% elsif ad_continues_after %}
            {% assign ad_radius_cls = "rounded-l--small" %}
          {% elsif bar.continues_before %}
            {% assign ad_radius_cls = "rounded-r--small" %}
          {% else %}
            {% assign ad_radius_cls = "rounded--small" %}
          {% endif %}

          {% assign allday_col_start = day_span | times: bar.start_col | plus: 2 %}
          {% assign allday_bar_span = day_span | times: allday_visible_span %}
          {% assign allday_row_num = bar.row | plus: 1 %}
          <div class="bg--{{ bar.hue }} text--{{ bar.fg }} flex flex--row flex--center-x flex--center-y cal-fit-box mx--0.5 {{ ad_radius_cls }}" style="grid-column:{{ allday_col_start }} / span {{ allday_bar_span }};grid-row:{{ allday_row_num }};overflow:hidden;box-sizing:border-box;border:2px solid currentColor;">
            <span class="title {{ chip_title_cls }} text--{{ bar.fg }} cal-fit-text cal-fit-clip w--min-0" data-fit-min="9" data-fit-max="90">{{ bar.title }}</span>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="grid gap--none h--[{{ grid_pct }}cqh] h--min-[{{ grid_pct }}cqh] flex-none">
      <div class="col--span-1 flex flex--col gap--none">
        {% for row in hour_rows %}

          <div class="h--[{{ row.pct }}cqh] w--full flex flex--row flex--right cal-row cal-fit-box relative pr--2 {% if row.shade == 1 %}bg--gray-65{% endif %}">

              {% if row.period %}<span class="cal-axis-period mr--1">{{ row.period }}</span>{% endif %}<span class="label {{ axis_cls }} {% if row.bold %}font--bold {% endif %}cal-fit-text cal-axis-text{% if row.important %} cal-axis-important{% endif %} inline-block text--right hours" data-fit-min="8" data-fit-max="40">{{ row.hour }}</span>
          </div>
        {% endfor %}
      </div>
      {% for day in days limit: shown_days_n %}
        <div class="col--span-{{ day_span }} flex flex--col gap--none border--v-1 relative">

          {% for seg in day.segments %}
            {% if seg.night %}

              {% assign seg_bg = "bg--gray-30" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-40" %}{% endif %}
            {% elsif day.is_today and seg.past %}

              {% assign seg_bg = "bg--gray-70" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-55" %}{% endif %}
            {% elsif day.is_today %}
              {% assign seg_bg = "" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-65" %}{% endif %}
            {% else %}
              {% assign seg_bg = "bg--gray-70" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-55" %}{% endif %}
            {% endif %}
            <div class="h--[{{ seg.pct }}cqh] w--full cal-row {{ seg_bg }} relative">
              {% if seg.weather %}

                <div class="absolute inset--0" style="background-image:repeating-linear-gradient(135deg, rgba(0,0,0,0.4) 0px, rgba(0,0,0,0.4) 3px, transparent 3px, transparent 9px);"></div>
              {% endif %}
            </div>
          {% endfor %}
          {% if day.now_marker %}

            <div class="absolute left--0 right--0" style="top:{{ day.now_marker.top_pct }}%;">
              {% if day.now_marker.night %}
                <div class="h--1 w--full bg--white"></div>
              {% else %}
                <div class="h--1 w--full bg--red"></div>
              {% endif %}
            </div>
          {% endif %}
          {% for event in day.events %}

            <div class="absolute px--0.5" style="top:{{ event.top_pct }}%;height:{{ event.height_pct }}%;left:calc({{ event.lane_index }} * 100% / {{ event.nlanes }});width:calc(100% / {{ event.nlanes }});box-sizing:border-box;">
              {% render "chip", hue: event.hue, fg: event.fg, title: event.title, flex_dir: "flex--col", size_class: "h--full w--full", size_style: "", pad_cls: event_pad_cls, radius_cls: "rounded--small", border_left: true, border_right: true, title_cls: event_title_cls, fit_min: 11, clip: false, pad_right_cls: pad_right_cls %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    <div class="grid gap--none h--[{{ footer_pct }}cqh] h--min-[{{ footer_pct }}cqh] bg--black flex-none" style="overflow:hidden;">
      <div class="col--span-1"></div>
      {% for day in days limit: shown_days_n %}
        <div class="col--span-{{ day_span }} flex flex--row flex--center-x flex--center-y gap--xsmall border--v-1" style="overflow:hidden;">
          {% if day.icon %}

            <img class="{{ chip_title_cls }} no-shrink w--6 h--6 lg:w--10 lg:h--10" style="filter:invert(1);" src="{{ day.icon }}">

            {%- if view <= 4 -%}

              <span class="label {{ chip_title_cls }} bg--black text--white w--min-0">
              <svg viewBox="0 0 10 10" class="w--2 h--2 lg:w--4 lg:h--4 mr--0_5 lg:mr--1 no-shrink" fill="#999"><polygon points="5,1 9,8 1,8"/></svg>
              <span class="mr--1">{{ day.temp.high }}°{{ temp_unit }}</span>
              <svg viewBox="0 0 10 10" class="w--2 h--2 lg:w--4 lg:h--4 mr--0_5 lg:mr--1 no-shrink" fill="#999"><polygon points="5,9 1,2 9,2"/></svg>
              <span>{{ day.temp.low }}°{{ temp_unit }}</span></span>
            {%- else -%}
              <span class="label {{ chip_title_cls }} bg--black text--white w--min-0">{{ day.temp.high }}° / {{ day.temp.low }}°</span>
            {%- endif -%}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
(function () {
  function fit(el, forced) {
    var box = el.closest('.cal-fit-box');
    if (!box) return null;
    var boxCsForPad = getComputedStyle(box);
    var padTop = parseFloat(boxCsForPad.paddingTop) || 0;
    var padBottom = parseFloat(boxCsForPad.paddingBottom) || 0;
    var minContentH = 14;
    var contentH = box.clientHeight - padTop - padBottom;
    if (contentH < minContentH && (padTop > 0 || padBottom > 0)) {
      var totalPad = padTop + padBottom;
      var shrink = Math.min(totalPad, minContentH - contentH);
      padTop = Math.max(0, padTop - shrink * (padTop / totalPad));
      padBottom = Math.max(0, padBottom - shrink * (padBottom / totalPad));
      box.style.paddingTop = padTop + 'px';
      box.style.paddingBottom = padBottom + 'px';
      contentH = box.clientHeight - padTop - padBottom;
    }
    var mustClip = el.classList.contains('cal-axis-text') || el.classList.contains('cal-fit-clip');
    box.style.overflow = mustClip ? 'hidden' : 'visible';
    el.style.display = 'block';
    var min = parseInt(el.getAttribute('data-fit-min'), 10) || 11;
    var max = parseInt(el.getAttribute('data-fit-max'), 10) || 90;

    function setSize(px) {
      el.style.fontSize = px + 'px';
      el.style.lineHeight = Math.round(px * 1.15) + 'px';
    }

    if (forced != null) {
      setSize(forced);
      return forced;
    }

    var boxCs = getComputedStyle(box);
    var padX = (parseFloat(boxCs.paddingLeft) || 0) + (parseFloat(boxCs.paddingRight) || 0);
    var availW = box.clientWidth - padX - 2;
    if (availW <= 0) { setSize(min); return min; }
    el.style.maxWidth = availW + 'px';

    function fitsOneLine(px) {
      return el.scrollWidth <= el.clientWidth + 1 && el.scrollHeight <= Math.round(px * 1.15) + 2 && el.scrollHeight <= contentH + 1;
    }
    function fitsWrapped() {
      return el.scrollHeight <= contentH + 1 && el.scrollWidth <= el.clientWidth + 1;
    }

    setSize(max);
    if (fitsOneLine(max)) return max;
    var isMultiWord = /\s/.test(el.textContent);
    var absMin = 4;

    function searchMax(lo, hi, test) {
      setSize(lo);
      if (!test(lo)) return null;
      while (hi - lo > 1) {
        var mid = Math.floor((lo + hi) / 2);
        setSize(mid);
        if (test(mid)) { lo = mid; } else { hi = mid; }
      }
      return lo;
    }

    var oneLineSize = searchMax(absMin, max, fitsOneLine);

    var wrappedSize = null;
    if (isMultiWord) {
      el.style.overflowWrap = 'normal';
      wrappedSize = searchMax(absMin, max, fitsWrapped);
    }

    if (oneLineSize !== null && (wrappedSize === null || wrappedSize <= oneLineSize)) {
      el.style.overflowWrap = 'anywhere';
      setSize(oneLineSize);
      return oneLineSize;
    }
    if (wrappedSize !== null) {
      el.style.overflowWrap = 'normal';
      setSize(wrappedSize);
      return wrappedSize;
    }

    el.style.overflowWrap = isMultiWord ? 'normal' : 'anywhere';
    setSize(absMin);
    box.style.overflow = 'hidden';
    return absMin;
  }

  function run() {
    var root = document.getElementById('cal-root');
    if (!root) return;
    var rows = root.querySelectorAll('.cal-row');
    for (var r = 0; r < rows.length; r++) rows[r].style.overflow = 'hidden';

    var lgPortrait = !!document.querySelector('.screen--lg.screen--portrait');

    var titles = root.querySelectorAll('.cal-fit-text:not(.cal-axis-text)');
    for (var i = 0; i < titles.length; i++) {
      if (lgPortrait) titles[i].setAttribute('data-fit-max', '100');
      fit(titles[i]);
    }

    function fitAxisGroup(selector, maxOverride) {
      var els = root.querySelectorAll(selector);
      var minSize = null;
      for (var j = 0; j < els.length; j++) {
        if (maxOverride) els[j].setAttribute('data-fit-max', maxOverride);
        var s = fit(els[j]);
        if (s != null && (minSize === null || s < minSize)) minSize = s;
      }
      if (minSize !== null) {
        for (var k = 0; k < els.length; k++) fit(els[k], minSize);
      }
    }
    fitAxisGroup('.cal-axis-important', lgPortrait ? '48' : null);
    fitAxisGroup('.cal-axis-text:not(.cal-axis-important)', lgPortrait ? '48' : null);

    var periodEls = root.querySelectorAll('.cal-axis-period');
    for (var p = 0; p < periodEls.length; p++) {
      var periodEl = periodEls[p];
      var hourEl = periodEl.nextElementSibling;
      if (!hourEl) continue;
      var hourPx = parseFloat(hourEl.style.fontSize) || 16;
      periodEl.style.fontSize = Math.round(hourPx * 0.72) + 'px';
    }
  }

  function runAfterFonts() {
    run();
    setTimeout(run, 400);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(run).catch(run);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runAfterFonts);
  } else {
    runAfterFonts();
  }
})();
</script>
{% endtemplate %}
