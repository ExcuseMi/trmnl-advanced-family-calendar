

{% template badge_circle %}

  <span class="rounded--small {{head_badge_cls}} no-shrink flex flex--center-x flex--center-y text--{{ fg }} bg--{{ hue }} font--bold">
    {{- b.text -}}
  </span>
{% endtemplate %}

{% template chip_body %}

  <div class="w--full h--full flex flex--row flex--center-x flex--center-y w--min-0">
    <span class="title {{ title_cls }} text--{{ fg }} text--center cal-fit-text{% if clip %} cal-fit-clip{% endif %} {{ pad_x_cls }} w--min-0" data-fit-min="{{ fit_min }}" data-fit-max="90">{{ title }}</span>
  </div>
{% endtemplate %}

{% template chip %}
  {%- assign border_color = "currentColor" -%}
  {%- if fg == "white" -%}{%- assign border_color = "#888888" -%}{%- endif -%}
  <div class="{{ size_class }} bg--{{ hue }} text--{{ fg }} w--full {{ pad_cls }} {{ radius_cls }} flex {{ flex_dir }} flex--center-y cal-fit-box relative" style="overflow:hidden;box-sizing:border-box;{{ size_style }}border-top:1px solid {{ border_color }};border-left:1px solid {{ border_color }};border-bottom:3px solid {{ border_color }};border-right:3px solid {{ border_color }};">
    {%- render "chip_body", title: title, fg: fg, title_cls: title_cls, fit_min: fit_min, clip: clip, pad_x_cls: pad_x_cls -%}
  </div>
{% endtemplate %}

{% template main %}
<style>

.trmnl .screen--lg.screen--portrait .cal-head-badge { }
.hours { font-family:monospace; width:2ch; }
.cal-axis-period { font-weight: normal; white-space: nowrap; }
</style>
{%- if view == 4 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
  {%- assign axis_cls = "label--small" -%}
  {%- assign event_pad_cls = "pt--0 pb--1" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_x_cls = "px--1" -%}
  {%- assign head_badge_cls = "w--3 h--3 lg:w--4 lg:h--4 rounded rounded--small"  -%}
{%- elsif view == 3 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
  {%- assign axis_cls = "label--base lg:label--large" -%}
  {%- assign event_pad_cls = "pt--0 pb--1" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_x_cls = "px--1" -%}
  {%- assign head_badge_cls = "w--3 h--3 lg:w--4 lg:h--4  rounded rounded--small" -%}
{%- elsif view == 2 -%}

  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small lg:title--base" -%}
  {%- assign axis_cls = "label--base lg:label--large" -%}
  {%- assign event_pad_cls = "pt--1 pb--2" -%}
  {%- assign event_title_cls = "title--small" -%}
  {%- assign pad_x_cls = "px--2" -%}
  {%- assign head_badge_cls = "w--3 h--3 lg:w--4 lg:h--4  rounded rounded--small" -%}
{%- else -%}

  {%- assign head_title_cls = "title--large lg:title--large lg:portrait:title--xlarge" -%}
  {%- assign chip_title_cls = "title--base lg:title--large lg:portrait:title--xlarge" -%}
  {%- assign axis_cls = "label--large lg:label--xxlarge" -%}
  {%- assign event_pad_cls = "pt--1 pb--2" -%}
  {%- assign event_title_cls = "title--base" -%}
  {%- assign pad_x_cls = "px--2" -%}
  {%- assign head_badge_cls = "w--4 h--4 lg:w--8 lg:h--8  rounded" -%}
{%- endif -%}

{%- if view == 1 -%}
  {%- assign shown_days_n = data.days.size -%}
{%- else -%}
  {%- assign shown_days_n = 1 -%}
{%- endif -%}

{%- if shown_days_n >= 6 -%}
  {%- assign head_title_cls = "title--small" -%}
  {%- assign chip_title_cls = "title--small" -%}
{%- elsif shown_days_n >= 4 -%}
  {%- assign head_title_cls = "title--base lg:title--large" -%}
  {%- assign chip_title_cls = "title--small" -%}
{%- endif -%}

{%- if shown_days_n == 1 -%}
  {%- assign day_span = 12 -%}
{%- elsif shown_days_n == 2 -%}
  {%- assign day_span = 6 -%}
{%- else -%}
  {%- assign day_span = 4 -%}
{%- endif -%}

<div class="layout layout--col gap--none" id="cal-root">
  {% if data.error and data.has_events == false %}

    <div class="flex flex--col flex--center-x flex--center-y w--full h--full text--center p--6 gap--small" style="box-sizing:border-box;">
      <img src="https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/event_busy/default/48px.svg" alt="" class="h--auto w--max-8 lg:w--max-12">
      <span class="title title--large">{{ data.unavailable_label }}</span>
      <span class="description text--gray-50 w--max-[85cqw]" data-clamp="3">{{ data.error }}</span>
    </div>
  {% else %}

    <div class="grid gap--none h--[{{ data.header_pct }}cqh] h--min-[{{ data.header_pct }}cqh] bg--black flex-none" style="overflow:hidden;">

      <div class="flex flex--col flex--center-x flex--center-y p--0.5" style="overflow:hidden;box-sizing:border-box;">

        {%- if data.people.size > 0 and view == 1 -%}

          <div class="grid w--auto gap--xsmall grid--cols-2 ">
            {%- for b in data.people limit: 4 -%}
              {%- render "badge_circle", head_badge_cls:head_badge_cls, b: b, hue: b.hue, fg: b.fg, extra: "cal-head-badge" -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {% for day in data.days limit: shown_days_n %}

        <div class="col--span-{{ day_span }} flex flex--col flex--center-x flex--center-y border--v-1">

          <div class="rounded--small px--2.5 py--0.5 w--max-full flex {% if shown_days_n == 1 %}flex--row flex--center-y flex--center-x gap--small{% else %}flex--col flex--center-x gap--xsmall{% endif %} w--min-0" style="overflow:hidden;">

            <span class="title {{ head_title_cls }} block w--min-0{% if shown_days_n == 1 %} no-shrink{% endif %}{% if day.is_today %} relative label--underline{% endif %}" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase;"><span class="text--gray-50">{{ day.label_short_weekday }}</span> <span class="text--white font--bold">{{ day.label_short_rest }}</span></span>
            {% if data.rss_headline and day.icon %}
              <span class="flex flex--row flex--center-y gap--xsmall no-shrink">
                <img class="{% if view == 1 %} w--5 h--5 lg:w--6 lg:h--6 {% else %} w--3 h--3 {% endif %} no-shrink" style="filter:invert(1);" src="{{ day.icon }}">
                <span class="label {% if view == 1 %}label--base{% else %}label--small{% endif %} text--white w--min-0">
                <svg viewBox="0 0 10 10" class="{% if view == 1 %} w--3 h--3 {% else %} w--2 h--2 {% endif %} mr--0.5 no-shrink" fill="#999"><polygon points="5,1 9,8 1,8"/></svg>
                <span class="mr--1">{{ day.temp.high }}°{{ data.temp_unit }}</span>
                <svg viewBox="0 0 10 10" class="{% if view == 1 %} w--3 h--3 {% else %} w--2 h--2 {% endif %} mr--0.5 no-shrink" fill="#999"><polygon points="5,9 1,2 9,2"/></svg>
                <span>{{ day.temp.low }}°{{ data.temp_unit }}</span></span>
              </span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if data.allday_pct > 0 %}

      {%- assign allday_total_units = day_span | times: shown_days_n | plus: 1 -%}
      <div class="grid gap--none h--[{{ data.allday_pct }}cqh] h--min-[{{ data.allday_pct }}cqh] flex-none relative" style="grid-template-columns:repeat({{ allday_total_units }}, 1fr);overflow:hidden;">

        <div class="col--span-1 flex flex--col flex--center-x flex--center-y px--0.5" style="grid-row:1 / span {{ data.allday_max_rows }};overflow:hidden;box-sizing:border-box;">
          <!-- <img src="https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/today/default/48px.svg" alt="{{ data.all_day_label }}" class="md:w--8 lg:w--12"> -->
        </div>
        {% for bar in data.allday_bars %}
          {% if bar.start_col < shown_days_n %}

          {% assign allday_visible_span = shown_days_n | minus: bar.start_col %}
          {% if bar.span <= allday_visible_span %}
            {% assign allday_visible_span = bar.span %}
          {% endif %}

          {% assign allday_col_start = day_span | times: bar.start_col | plus: 2 %}
          {% assign allday_bar_span = day_span | times: allday_visible_span %}
          {% assign allday_row_num = bar.row | plus: 1 %}
          {% assign ad_border_color = "currentColor" %}
          {% if bar.fg == "white" %}{% assign ad_border_color = "#888888" %}{% endif %}
          <div class="bg--{{ bar.hue }} text--{{ bar.fg }} flex flex--row flex--center-x flex--center-y cal-fit-box rounded--none" style="grid-column:{{ allday_col_start }} / span {{ allday_bar_span }};grid-row:{{ allday_row_num }};overflow:hidden;box-sizing:border-box;border-bottom:1px solid {{ ad_border_color }};">
            <span class="title {{ chip_title_cls }} text--{{ bar.fg }} cal-fit-text cal-fit-clip w--min-0" data-fit-min="9" data-fit-max="90">{{ bar.title }}</span>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="grid gap--none h--[{{ data.grid_pct }}cqh] h--min-[{{ data.grid_pct }}cqh] flex-none relative">
      <div class="col--span-1 flex flex--col gap--none">
        {% for row in data.hour_rows %}

          <div class="h--[{{ row.pct }}cqh] w--full flex flex--row {% if row.period %}gap--distribute{% else %}flex--right{% endif %} cal-row cal-fit-box relative pr--2 {% if row.current %}bg--black{% elsif row.shade == 1 %}bg--gray-65{% endif %}" {% if row.current %}style="border-top:1px solid #888888;"{% endif %}>

              {% if row.period %}<span class="cal-axis-period {% if row.current %}text--gray-70{% else %}text--gray-15{% endif %} mr--1">{{ row.period }}</span>{% endif %}<span class="label {{ axis_cls }} {% if row.bold %}font--bold {% endif %}{% if row.current %}text--white {% endif %}cal-fit-text cal-axis-text{% if row.important %} cal-axis-important{% endif %} inline-block text--right hours" data-fit-min="8" data-fit-max="40">{{ row.hour }}</span>
          </div>
        {% endfor %}
      </div>
      {% for day in data.days limit: shown_days_n %}
        <div class="col--span-{{ day_span }} flex flex--col gap--none border--v-1 relative">

          {% assign seg_cum_pct = 0 %}
          {% for seg in day.segments %}
            {% if seg.night %}

              {% assign seg_bg = "bg--gray-30" %}
            {% elsif day.is_today and seg.past %}

              {% assign seg_bg = "bg--gray-70" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-55" %}{% endif %}
            {% elsif day.is_today %}
              {% assign seg_bg = "" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-65" %}{% endif %}
            {% else %}
              {% assign seg_bg = "bg--gray-70" %}
              {% if seg.shade == 1 %}{% assign seg_bg = "bg--gray-55" %}{% endif %}
            {% endif %}
            <div class="h--[{{ seg.pct }}cqh] w--full cal-row {{ seg_bg }} relative" {% if seg.night %}style="border-bottom:1px solid rgba(255,255,255,0.2);"{% endif %}>
              {% if seg.weather == "rain" %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Cpath fill=%27%23888888%27 d=%27M7 3c-1.6 2.2-2.6 4.1-2.6 5.6 0 1.9 1.2 3.4 2.6 3.4s2.6-1.5 2.6-3.4C9.6 7.1 8.6 5.2 7 3z%27 transform=%27rotate(15 7 7.5)%27/%3E%3Cpath fill=%27%23888888%27 d=%27M20 13c-1.6 2.2-2.6 4.1-2.6 5.6 0 1.9 1.2 3.4 2.6 3.4s2.6-1.5 2.6-3.4c0-1.5-1-3.4-2.6-5.6z%27 transform=%27rotate(15 20 17.5)%27/%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% elsif seg.weather == "storm" %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Cpath fill=%27%23555555%27 d=%27M6 2c-1.8 2.4-3 4.5-3 6.1 0 2.1 1.3 3.9 3 3.9s3-1.8 3-3.9C9 6.5 7.8 4.4 6 2z%27 transform=%27rotate(15 6 6)%27/%3E%3Cpath fill=%27%23555555%27 d=%27M20 2c-1.8 2.4-3 4.5-3 6.1 0 2.1 1.3 3.9 3 3.9s3-1.8 3-3.9C23 6.5 21.8 4.4 20 2z%27 transform=%27rotate(15 20 6)%27/%3E%3Cpath fill=%27%23555555%27 d=%27M13 14c-1.8 2.4-3 4.5-3 6.1 0 2.1 1.3 3.9 3 3.9s3-1.8 3-3.9c0-1.6-1.2-3.7-3-6.1z%27 transform=%27rotate(15 13 18)%27/%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% elsif seg.weather == "snow" %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Cg stroke=%27%23999999%27 stroke-width=%271%27 stroke-linecap=%27round%27%3E%3Cg transform=%27translate(7,7)%27%3E%3Cline x1=%27-3%27 y1=%270%27 x2=%273%27 y2=%270%27/%3E%3Cline x1=%270%27 y1=%27-3%27 x2=%270%27 y2=%273%27/%3E%3Cline x1=%27-2.1%27 y1=%27-2.1%27 x2=%272.1%27 y2=%272.1%27/%3E%3Cline x1=%27-2.1%27 y1=%272.1%27 x2=%272.1%27 y2=%27-2.1%27/%3E%3C/g%3E%3Cg transform=%27translate(20,18)%27%3E%3Cline x1=%27-3%27 y1=%270%27 x2=%273%27 y2=%270%27/%3E%3Cline x1=%270%27 y1=%27-3%27 x2=%270%27 y2=%273%27/%3E%3Cline x1=%27-2.1%27 y1=%27-2.1%27 x2=%272.1%27 y2=%272.1%27/%3E%3Cline x1=%27-2.1%27 y1=%272.1%27 x2=%272.1%27 y2=%27-2.1%27/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% elsif seg.weather %}
                <div class="absolute inset--0" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2728%27 height=%2728%27 viewBox=%270 0 28 28%27%3E%3Crect x=%270%27 y=%277%27 width=%2714%27 height=%272.5%27 rx=%271.25%27 fill=%27%23aaaaaa%27/%3E%3Crect x=%2714%27 y=%2718%27 width=%2714%27 height=%272.5%27 rx=%271.25%27 fill=%27%23aaaaaa%27/%3E%3C/svg%3E');background-position:0 -{{ seg_cum_pct }}cqh;"></div>
              {% endif %}
            </div>
            {% assign seg_cum_pct = seg_cum_pct | plus: seg.pct %}
          {% endfor %}
          {% for event in day.events %}

            <div class="absolute px--0.5 relative z--1" style="top:{{ event.top_pct }}%;height:{{ event.height_pct }}%;left:calc({{ event.lane_index }} * 100% / {{ event.nlanes }});width:calc(100% / {{ event.nlanes }});box-sizing:border-box;">
              {% render "chip", hue: event.hue, fg: event.fg, title: event.title, flex_dir: "flex--col", size_class: "h--full w--full", size_style: "", pad_cls: event_pad_cls, radius_cls: "rounded--xsmall", title_cls: event_title_cls, fit_min: 11, clip: false, pad_x_cls: pad_x_cls %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
      {% if data.days.first.now_marker %}
        <div class="absolute left--0 right--0 z--0" style="grid-column:2 / -1;top:{{ data.days.first.now_marker.top_pct }}%;">
          {% if data.days.first.now_marker.night %}
            <div class="h--1 w--full bg--gray-70"></div>
          {% else %}
            <div class="h--1 w--full bg--red"></div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="grid gap--none h--[{{ data.footer_pct }}cqh] h--min-[{{ data.footer_pct }}cqh] bg--black flex flex--center-y" style="overflow:hidden;">
      {% if data.rss_headline %}
        <div class="h--full col--span-{{ shown_days_n | times: day_span | plus: 1 }} flex flex--row flex--center-y flex--left pl--2 pr--2 w--min-0" style="overflow:hidden;">
          <span class="label {% if view == 1 %}label--base{% else %}label--small{% endif %} font--bold bg--black text--white w--min-0 w--full" style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase;letter-spacing:0.5px;">{{ data.rss_headline }}</span>
        </div>
      {% else %}
      <div class="col--span-1 flex flex--center-x">
        <svg class="{% if view == 1 %} w--6 h--6  lg:w--10 lg:h--10 {% else if view == 2 or view == 4 %} hidden {% else %} w--4 h--4 {% endif %} image" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.75 2.5C7.75 2.08579 7.41421 1.75 7 1.75C6.58579 1.75 6.25 2.08579 6.25 2.5V4.07926C4.81067 4.19451 3.86577 4.47737 3.17157 5.17157C2.47737 5.86577 2.19451 6.81067 2.07926 8.25H21.9207C21.8055 6.81067 21.5226 5.86577 20.8284 5.17157C20.1342 4.47737 19.1893 4.19451 17.75 4.07926V2.5C17.75 2.08579 17.4142 1.75 17 1.75C16.5858 1.75 16.25 2.08579 16.25 2.5V4.0129C15.5847 4 14.839 4 14 4H10C9.16097 4 8.41527 4 7.75 4.0129V2.5Z" fill="white"/>
<path fill-rule="evenodd" clip-rule="evenodd" d="M2 12C2 11.161 2 10.4153 2.0129 9.75H21.9871C22 10.4153 22 11.161 22 12V14C22 17.7712 22 19.6569 20.8284 20.8284C19.6569 22 17.7712 22 14 22H10C6.22876 22 4.34315 22 3.17157 20.8284C2 19.6569 2 17.7712 2 14V12ZM17 14C17.5523 14 18 13.5523 18 13C18 12.4477 17.5523 12 17 12C16.4477 12 16 12.4477 16 13C16 13.5523 16.4477 14 17 14ZM17 18C17.5523 18 18 17.5523 18 17C18 16.4477 17.5523 16 17 16C16.4477 16 16 16.4477 16 17C16 17.5523 16.4477 18 17 18ZM13 13C13 13.5523 12.5523 14 12 14C11.4477 14 11 13.5523 11 13C11 12.4477 11.4477 12 12 12C12.5523 12 13 12.4477 13 13ZM13 17C13 17.5523 12.5523 18 12 18C11.4477 18 11 17.5523 11 17C11 16.4477 11.4477 16 12 16C12.5523 16 13 16.4477 13 17ZM7 14C7.55228 14 8 13.5523 8 13C8 12.4477 7.55228 12 7 12C6.44772 12 6 12.4477 6 13C6 13.5523 6.44772 14 7 14ZM7 18C7.55228 18 8 17.5523 8 17C8 16.4477 7.55228 16 7 16C6.44772 16 6 16.4477 6 17C6 17.5523 6.44772 18 7 18Z" fill="white"/>
</svg>
      </div>
        {% for day in data.days limit: shown_days_n %}
          <div class="h--full  col--span-{{ day_span }} flex flex--row flex--center-x flex--center-y gap--xsmall border--v-1" style="overflow:hidden;">
            {% if day.icon %}

              <img class="{{ chip_title_cls }} no-shrink  {% if view == 1 %} w--6 h--6  lg:w--10 lg:h--10 {% else %} w--4 h--4  {% endif %}" style="filter:invert(1);" src="{{ day.icon }}">

              {%- if view <= 4 -%}

                <span class="label {{ chip_title_cls }} bg--black text--white w--min-0">
                <svg viewBox="0 0 10 10" class="w--2 h--2 lg:w--4 lg:h--4 mr--0.5 lg:mr--1 no-shrink" fill="#999"><polygon points="5,1 9,8 1,8"/></svg>
                <span class="mr--1">{{ day.temp.high }}°{{ data.temp_unit }}</span>
                <svg viewBox="0 0 10 10" class="w--2 h--2 lg:w--4 lg:h--4 mr--0.5 lg:mr--1 no-shrink" fill="#999"><polygon points="5,9 1,2 9,2"/></svg>
                <span>{{ day.temp.low }}°{{ data.temp_unit }}</span></span>
              {%- else -%}
                <span class="label {{ chip_title_cls }} bg--black text--white w--min-0">{{ day.temp.high }}° / {{ day.temp.low }}°</span>
              {%- endif -%}
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}
</div>

<script>
(function () {
  function fit(el, forced) {
    var box = el.closest('.cal-fit-box');
    if (!box) return null;
    var boxCsForPad = getComputedStyle(box);
    var padTop = parseFloat(boxCsForPad.paddingTop) || 0;
    var padBottom = parseFloat(boxCsForPad.paddingBottom) || 0;
    var minContentH = 14;
    var contentH = box.clientHeight - padTop - padBottom;
    if (contentH < minContentH && (padTop > 0 || padBottom > 0)) {
      var totalPad = padTop + padBottom;
      var shrink = Math.min(totalPad, minContentH - contentH);
      padTop = Math.max(0, padTop - shrink * (padTop / totalPad));
      padBottom = Math.max(0, padBottom - shrink * (padBottom / totalPad));
      box.style.paddingTop = padTop + 'px';
      box.style.paddingBottom = padBottom + 'px';
      contentH = box.clientHeight - padTop - padBottom;
    }
    var mustClip = el.classList.contains('cal-axis-text') || el.classList.contains('cal-fit-clip');
    box.style.overflow = mustClip ? 'hidden' : 'visible';
    el.style.display = 'block';
    var min = parseInt(el.getAttribute('data-fit-min'), 10) || 11;
    var max = parseInt(el.getAttribute('data-fit-max'), 10) || 90;

    function setSize(px) {
      el.style.fontSize = px + 'px';
      el.style.lineHeight = Math.round(px * 1.15) + 'px';
    }

    if (forced != null) {
      setSize(forced);
      return forced;
    }

    var boxCs = getComputedStyle(box);
    var padX = (parseFloat(boxCs.paddingLeft) || 0) + (parseFloat(boxCs.paddingRight) || 0);
    var availW = box.clientWidth - padX - 2;
    if (availW <= 0) { setSize(min); return min; }
    el.style.maxWidth = availW + 'px';

    function fitsOneLine(px) {
      return el.scrollWidth <= el.clientWidth + 1 && el.scrollHeight <= Math.round(px * 1.15) + 2 && el.scrollHeight <= contentH + 1;
    }
    function fitsWrapped() {
      return el.scrollHeight <= contentH + 1 && el.scrollWidth <= el.clientWidth + 1;
    }

    setSize(max);
    if (fitsOneLine(max)) return max;
    var isMultiWord = /\s/.test(el.textContent);
    var absMin = 4;

    function searchMax(lo, hi, test) {
      setSize(lo);
      if (!test(lo)) return null;
      while (hi - lo > 1) {
        var mid = Math.floor((lo + hi) / 2);
        setSize(mid);
        if (test(mid)) { lo = mid; } else { hi = mid; }
      }
      return lo;
    }

    var oneLineSize = searchMax(absMin, max, fitsOneLine);

    var wrappedSize = null;
    if (isMultiWord) {
      el.style.overflowWrap = 'normal';
      wrappedSize = searchMax(absMin, max, fitsWrapped);
    }

    if (oneLineSize !== null && (wrappedSize === null || wrappedSize <= oneLineSize)) {
      el.style.overflowWrap = 'anywhere';
      setSize(oneLineSize);
      return oneLineSize;
    }
    if (wrappedSize !== null) {
      el.style.overflowWrap = 'normal';
      setSize(wrappedSize);
      return wrappedSize;
    }

    el.style.overflowWrap = isMultiWord ? 'normal' : 'anywhere';
    setSize(absMin);
    box.style.overflow = 'hidden';
    return absMin;
  }

  function run() {
    var root = document.getElementById('cal-root');
    if (!root) return;
    var rows = root.querySelectorAll('.cal-row');
    for (var r = 0; r < rows.length; r++) rows[r].style.overflow = 'hidden';

    var lgPortrait = !!document.querySelector('.screen--lg.screen--portrait');

    var titles = root.querySelectorAll('.cal-fit-text:not(.cal-axis-text)');
    for (var i = 0; i < titles.length; i++) {
      if (lgPortrait) titles[i].setAttribute('data-fit-max', '100');
      fit(titles[i]);
    }

    function fitAxisGroup(selector, maxOverride) {
      var all = root.querySelectorAll(selector);
      var els = [];
      for (var i = 0; i < all.length; i++) {
        var box = all[i].closest('.cal-fit-box');
        if (box && box.clientHeight > 0) els.push(all[i]);
      }
      var minSize = null;
      for (var j = 0; j < els.length; j++) {
        if (maxOverride) els[j].setAttribute('data-fit-max', maxOverride);
        var s = fit(els[j]);
        if (s != null && (minSize === null || s < minSize)) minSize = s;
      }
      if (minSize !== null) {
        for (var k = 0; k < els.length; k++) fit(els[k], minSize);
      }
    }
    fitAxisGroup('.cal-axis-important', lgPortrait ? '48' : null);
    fitAxisGroup('.cal-axis-text:not(.cal-axis-important)', lgPortrait ? '48' : null);

    var periodEls = root.querySelectorAll('.cal-axis-period');
    for (var p = 0; p < periodEls.length; p++) {
      var periodEl = periodEls[p];
      var hourEl = periodEl.nextElementSibling;
      if (!hourEl) continue;
      var hourPx = parseFloat(hourEl.style.fontSize) || 16;
      periodEl.style.fontSize = Math.round(hourPx * 0.72) + 'px';
    }
  }

  function runAfterFonts() {
    run();
    setTimeout(run, 400);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(run).catch(run);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runAfterFonts);
  } else {
    runAfterFonts();
  }
})();
</script>
{% endtemplate %}
