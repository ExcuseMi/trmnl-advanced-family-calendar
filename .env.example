# Backend
BACKEND_PORT=8902
PUBLIC_BASE_URL=https://trmnl.bettens.dev/advanced-family-calendar

# whitelist_only: TRMNL IPs only (blocks the Configuration Editor running in a browser)
# rate_limited:   TRMNL unrestricted, public callers (e.g. the Configuration Editor) rate limited
# open:           no restrictions (local dev)
ACCESS_MODE=rate_limited
IP_REFRESH_HOURS=24
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_RATE_LIMIT_MAX_REQUESTS=20

# Image uploads (person/category photos) — see backend/modules/utils/images.py
MAX_UPLOAD_BYTES=10485760
# ICS proxy (CORS-free calendar test) — see backend/app.py
MAX_PROXY_BYTES=15728640
FETCH_TIMEOUT_SECONDS=15

# Postgres (image storage)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Redis (rate limiting)
REDIS_PASSWORD=change-me
